        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, lane) (rate(sms_delivery_latency_seconds_bucket[1m])))",
          "legendFormat": "p99 {{lane}}"
